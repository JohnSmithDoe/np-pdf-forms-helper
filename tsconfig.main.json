{
  "compilerOptions": {
    "outDir": "dist/main",
    "rootDir": "electron",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "commonjs",
    "target": "es2022",
    "types": ["node"],
    "lib": ["es2022", "dom"]
  },
  "files": ["electron/main.ts"],
  "include": ["electron/bridge/**/*.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
