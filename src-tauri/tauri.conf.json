{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "npDokumentenhilfe",
  "version": "2.0.1",
  "identifier": "de.npdokumentenhilfe.desktop",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://localhost:4400",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "npDokumentenhilfe",
        "width": 1024,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../eula.txt",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
