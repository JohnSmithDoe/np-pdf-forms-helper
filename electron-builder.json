{
  "asar": false,
  "directories": {
    "output": "release/",
    "app": "electron"
  },
  "files": ["**/*", "!**/*.ts", "!*.map", "!package.json", "!pnpm-lock.yaml"],
  "extraResources": [
    {
      "from": "dist/main",
      "to": "app",
      "filter": ["**/*", "!*.map"]
    },
    {
      "from": "dist/renderer",
      "to": "renderer",
      "filter": ["**/*", "!*.map"]
    },
    {
      "from": "pdftk",
      "to": "../pdftk",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "icon": "dist/renderer/assets/icons",
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "deleteAppDataOnUninstall": true,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "license": "./eula.txt",
    "perMachine": false,
    "publish": null,
    "createDesktopShortcut": true
  },
  "mac": {
    "icon": "dist/renderer/assets/icons",
    "target": ["dmg"]
  },
  "linux": {
    "icon": "dist/renderer/assets/icons",
    "target": ["AppImage"]
  }
}
