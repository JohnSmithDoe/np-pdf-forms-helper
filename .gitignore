# See http://help.github.com/ignore-files/ for more about ignoring files.
.angular
# Anchored: unanchored, `data` matches EVERY directory of that name, and the
# architecture puts one in each domain (src/app/<domain>/data). This is the
# app's runtime data folder at the repo root, nothing else.
/data
app/**/*.js
# config / env file
.npconfig

# compiled output
/dist
/dist/renderer
# Cargo's build cache, and the permission schemas tauri-build regenerates from
# the installed plugins on every build — both are derived, both are large.
/src-tauri/target
/src-tauri/gen/schemas
# `tauri dev` runs the binary with src-tauri/ as its working directory, so the
# app's `./data` folder lands there instead of at the repo root.
/src-tauri/data
/tmp
/out-tsc
/app-builds
/release
main.js
src/**/*.js
*.js.map

# dependencies
node_modules

# IDEs and editors
.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.angular/cache
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
testem.log
/typings

# e2e — Playwright's run artifacts. The specs themselves are tracked.
/test-results
/playwright-report
/blob-report

# System Files
.DS_Store
Thumbs.db

# eslint writes this on every run; it was tracked, so every lint dirtied the tree.
.eslintcache
/out-tsc
