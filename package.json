{
  "name": "np-fill-in-helper",
  "version": "1.1.9",
  "description": "Copy and fill xlsx and pdf documents with the same input data",
  "main": "dist/main/main.js",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "postinstall": "pnpm run install:app",
    "prepare": "lefthook install",
    "ng": "ng",
    "start": "ng serve",
    "ng:serve": "ng serve -c development -o",
    "watch": "ng build --watch -c development",
    "build": "ng build --base-href ./",
    "ng:build": "ng build --base-href ./",
    "electron:start": "npm-run-all -p electron:serve ng:serve",
    "electron:serve": "wait-on tcp:4200 && pnpm run electron:tsc && electron . --serve",
    "electron:serve:debug": "electron . --serve --debug --npdebug",
    "electron:tsc": "tsc -p tsconfig.main.json",
    "build:all": "pnpm run electron:tsc && ng build --base-href ./",
    "build:all:prod": "pnpm run build:all -c production",
    "electron:local": "pnpm run build:all:prod && electron .",
    "electron:unpacked": "pnpm run build:all:prod && electron-builder build --publish=never --dir",
    "electron:build": "electron-builder build --publish=never --dir",
    "electron:packaged": "pnpm run build:all:prod && electron-builder build --publish=never",
    "install:app": "pnpm --dir electron --ignore-workspace --node-linker=hoisted install",
    "lint": "pnpm run lint:eslint && pnpm run lint:styles",
    "lint:eslint": "ng lint",
    "lint:styles": "stylelint \"src/**/*.{scss,css}\"",
    "verify": "sheriff verify src/main.ts",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"electron/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"electron/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnSmithDoe/npDocumentFiller.git"
  },
  "keywords": [
    "pdftk",
    "pdffiller",
    "pdfform",
    "xlsxfiller",
    "electron",
    "angular",
    "german"
  ],
  "author": "leto the c0dem0nkey",
  "license": "GNU GENERAL PUBLIC LICENSE Version 2",
  "bugs": {
    "url": "https://github.com/JohnSmithDoe/npDocumentFiller/issues"
  },
  "homepage": "https://github.com/JohnSmithDoe/npDocumentFiller#readme",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/forms": "^21.2.20",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.20",
    "@angular/router": "^21.2.20",
    "@ngrx/signals": "^21.1.1",
    "exceljs": "^4.3.0",
    "iconv-lite": "^0.6.3",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "uuid": "^8.3.2"
  },
  "peerDependecies": {
    "uuid": "^8.3.2",
    "iconv-lite": "^0.6.3",
    "exceljs": "^4.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.20",
    "@angular/language-service": "^21.2.20",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "@types/node": "^22.20.1",
    "angular-eslint": "^21.4.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-debug": "3.2.0",
    "electron-reloader": "1.2.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "lefthook": "^2.1.10",
    "npm-run-all": "4.1.5",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "wait-on": "6.0.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
