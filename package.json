{
  "name": "np-office-document-helper",
  "version": "2.0.1",
  "description": "Copy and fill xlsx and pdf documents with the same input data",
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "prepare": "lefthook install",
    "ng": "ng",
    "start": "ng serve",
    "ng:serve": "ng serve -c development -o",
    "watch": "ng build --watch -c development",
    "build": "ng build --base-href ./",
    "ng:build": "ng build --base-href ./",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "pnpm run lint:eslint && pnpm run lint:styles",
    "lint:eslint": "ng lint",
    "lint:styles": "stylelint \"src/**/*.{scss,css}\"",
    "verify": "sheriff verify src/main.ts",
    "typecheck": "ngc -p tsconfig.check.json",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\" playwright.config.ts playwright.release.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\" playwright.config.ts playwright.release.config.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:release": "pnpm run build && playwright test --config playwright.release.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnSmithDoe/np-office-document-helper.git"
  },
  "keywords": [
    "pdffiller",
    "pdfform",
    "xlsxfiller",
    "tauri",
    "rust",
    "angular",
    "german"
  ],
  "author": "leto the c0dem0nkey",
  "license": "GNU GENERAL PUBLIC LICENSE Version 2",
  "bugs": {
    "url": "https://github.com/JohnSmithDoe/np-office-document-helper/issues"
  },
  "homepage": "https://github.com/JohnSmithDoe/np-office-document-helper#readme",
  "dependencies": {
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/forms": "^21.2.20",
    "@angular/platform-browser": "^21.2.20",
    "@angular/router": "^21.2.20",
    "@ionic/angular": "^8.8.18",
    "@ionic/core": "^8.8.18",
    "@ngrx/signals": "^21.1.1",
    "@tauri-apps/api": "^2.11.1",
    "ionicons": "^7.4.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.20",
    "@angular/language-service": "^21.2.20",
    "@playwright/test": "^1.62.1",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.1",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "lefthook": "^2.1.10",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
